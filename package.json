{
  "name": "@adlabs/nexus",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Nexus API (Cardano, Bitcoin, Midnight) — typed, namespaced client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gero-Labs/nexus-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript ${NEXUS_OPENAPI_URL:-https://nexus.gerowallet.io/v3/api-docs} -o src/generated/schema.d.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
